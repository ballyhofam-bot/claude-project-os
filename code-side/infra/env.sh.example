#!/usr/bin/env bash
# Single source of truth for token + API URL.
# Source this in skills: `source ~/projects/your-project/infra/env.sh`
# On token rotation, update ONLY this file.
#
# DO NOT COMMIT THIS FILE. Add to .gitignore.

export WORKER_TOKEN='your-bearer-token-here'
export WORKER_API='https://your-worker.workers.dev'

# Usage:
#   api /stats | jq .
#   api "/tasks?status=todo&ownership=mine" | jq .
#   api /tasks -X POST -H 'Content-Type: application/json' -d '{"title":"..."}'
api() {
  local path="$1"; shift
  curl -s -H "Authorization: Bearer $WORKER_TOKEN" "$WORKER_API$path" "$@"
}
